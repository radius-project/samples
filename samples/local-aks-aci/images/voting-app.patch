Read Redis and PostgreSQL connection settings from environment variables, and update Npgsql for CVE-2024-32655.
Applied by .github/workflows/build.yaml before it builds the vote, worker, and result images.

diff --git a/result/server.js b/result/server.js
index 1c8593e..6024d71 100644
--- a/result/server.js
+++ b/result/server.js
@@ -17,15 +17,34 @@ io.on('connection', function (socket) {
   });
 });

-var pool = new Pool({
-  connectionString: 'postgres://postgres:postgres@db/postgres'
-});
+var sslMode = (process.env.POSTGRES_SSLMODE || 'disable').toLowerCase();
+if (['disable', 'prefer', 'require'].indexOf(sslMode) < 0) {
+  throw new Error('Unsupported POSTGRES_SSLMODE: ' + sslMode);
+}
+
+function createPool(useSsl) {
+  return new Pool({
+    host: process.env.POSTGRES_HOST || 'db',
+    port: parseInt(process.env.POSTGRES_PORT || '5432', 10),
+    user: process.env.POSTGRES_USER || 'postgres',
+    password: process.env.POSTGRES_PASSWORD || 'postgres',
+    database: process.env.POSTGRES_DB || 'postgres',
+    // Like libpq sslmode=prefer/require: encrypt without verifying the server certificate.
+    ssl: useSsl ? { rejectUnauthorized: false } : false
+  });
+}
+
+var pool = createPool(sslMode !== 'disable');

 async.retry(
   {times: 1000, interval: 1000},
   function(callback) {
     pool.connect(function(err, client, done) {
       if (err) {
+        if (sslMode === 'prefer' && /does not support SSL/i.test(err.message)) {
+          console.log("Server does not support SSL, retrying without it");
+          pool = createPool(false);
+        }
         console.error("Waiting for db");
       }
       callback(err, client);
