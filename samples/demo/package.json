{
  "name": "demo",
  "version": "1.0.0",
  "description": "This application is used to demonstrate Radius basics as part of our 'first application' tutorial.",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "node build-client.js",
    "build:server": "rimraf ./dist && rimraf ./www && tsc",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:client": "node start-client.js",
    "start:server": "npm run build && node dist/main.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.17",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.9.0",
    "@dapr/dapr": "^3.5.2",
    "@types/mongodb": "^4.0.7",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.11.11",
    "@types/redis": "^4.0.11",
    "@types/uuid": "^10.0.0",
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongodb": "^6.15.0",
    "morgan": "^1.10.0",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "uuid": "^11.1.0"
  }
}
